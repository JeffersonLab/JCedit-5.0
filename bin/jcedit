#!/bin/bash

# JCedit launcher script

# Determine the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Path to the jar file (script is in bin/, jar is in build/libs/)
JAR_FILE="${SCRIPT_DIR}/../build/libs/jcedit-5.0-SNAPSHOT.jar"

# Check if jar exists
if [ ! -f "$JAR_FILE" ]; then
    echo "Error: JAR file not found at $JAR_FILE"
    echo "Please run './gradlew build' first to build the project."
    exit 1
fi

# Check if Java is available
if ! command -v java &> /dev/null; then
    echo "Error: Java is not installed or not in PATH"
    exit 1
fi

# Run the application with all passed arguments
exec java -jar "$JAR_FILE" "$@"
